# PredictCNC Configuration — Flask & PostgreSQL Stack
SECRET_KEY=predictcnc-academic-secret-key-change-in-production
FLASK_ENV=development
FLASK_PORT=5000

# PostgreSQL Configuration (Default port 5432)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-postgres-password
PG_DB=predictcnc

# Gmail SMTP Configuration for Warning & Critical Alerts
# (Generate a 16-character App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM=your-email@gmail.com
SMTP_ALERT_COOLDOWN_MINUTES=15
DEFAULT_SUPERVISOR_EMAIL=supervisor@predictcnc.local
